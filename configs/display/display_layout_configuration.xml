<layouts>
    <layout>
        <state>0</state>
        <name>closed</name>

        <display enabled="true" defaultDisplay="true">
            <port>129</port>
        </display>

        <display enabled="false">
            <port>130</port>
        </display>
    </layout>

    <layout>
        <state>1</state>
        <name>opened</name>

        <display enabled="true" defaultDisplay="true">
            <port>129</port>
        </display>

        <!-- Keep the swivel panel out of the default (AOD-capable) power group. -->
        <display enabled="true" displayGroup="swivel">
            <port>130</port>
        </display>
    </layout>
</layouts>
