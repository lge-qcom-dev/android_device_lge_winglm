# LG Wing swivel display touchscreen
#
# The panel is natively portrait (1080x1240).  Associate it with its own
# physical display so InputReader uses that display's viewport and rotation.
device.internal = 1

touch.deviceType = touchScreen
touch.displayId = local:4630946299134858882
