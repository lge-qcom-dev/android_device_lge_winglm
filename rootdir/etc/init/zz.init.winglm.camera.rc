on early-init
    setprop vendor.camera.aux.packagelist org.lineageos.aperture

service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service-winglm
    override
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    class hal
    user cameraserver
    group audio camera input drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
